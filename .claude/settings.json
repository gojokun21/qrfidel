{
    "permissions": {
        "allow": [
            "Bash(php artisan test*)",
            "Bash(php artisan make:*)",
            "Bash(php artisan route:list*)",
            "Bash(php artisan about*)",
            "Bash(php artisan list*)",
            "Bash(php artisan migrate)",
            "Bash(php artisan migrate:status*)",
            "Bash(php artisan db:seed*)",
            "Bash(php artisan config:clear*)",
            "Bash(php artisan view:clear*)",
            "Bash(php artisan optimize:clear*)",
            "Bash(composer test*)",
            "Bash(composer lint*)",
            "Bash(composer analyse*)",
            "Bash(composer check*)",
            "Bash(./vendor/bin/pint*)",
            "Bash(./vendor/bin/phpstan*)",
            "Bash(npm run *)",
            "Bash(docker compose ps*)",
            "Bash(docker compose up*)",
            "Bash(docker compose logs*)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "PowerShell(php artisan test*)",
            "PowerShell(php artisan make:*)",
            "PowerShell(php artisan route:list*)",
            "PowerShell(php artisan about*)",
            "PowerShell(php artisan list*)",
            "PowerShell(php artisan migrate)",
            "PowerShell(php artisan migrate:status*)",
            "PowerShell(php artisan db:seed*)",
            "PowerShell(php artisan config:clear*)",
            "PowerShell(php artisan view:clear*)",
            "PowerShell(php artisan optimize:clear*)",
            "PowerShell(composer test*)",
            "PowerShell(composer lint*)",
            "PowerShell(composer analyse*)",
            "PowerShell(composer check*)",
            "PowerShell(./vendor/bin/pint*)",
            "PowerShell(./vendor/bin/phpstan*)",
            "PowerShell(npm run *)",
            "PowerShell(docker compose ps*)",
            "PowerShell(docker compose up*)",
            "PowerShell(docker compose logs*)",
            "PowerShell(git status*)",
            "PowerShell(git diff*)",
            "PowerShell(git log*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/.claude/hooks/pint-file.php\"",
                        "timeout": 60,
                        "statusMessage": "Pint pe fișierul modificat..."
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-tests.php\"",
                        "timeout": 300,
                        "statusMessage": "composer test..."
                    }
                ]
            }
        ]
    }
}
